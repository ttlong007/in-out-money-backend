# Copy to .env and fill in. `.env` is git-ignored.

PORT=8787

# Port the Docker Postgres publishes on. Change both this and DATABASE_URL
# together if 55432 collides with something else on your machine.
DB_PORT=55432

# Matches docker-compose.yml. Point this at any Postgres if you'd rather not use Docker.
DATABASE_URL=postgres://inout:inout@localhost:55432/inout

# Signs access and refresh tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it invalidates every issued token, which is the intended panic button.
JWT_SECRET=

# Optional. Without it the server still runs and /v1/ai/* returns 503 —
# the app falls back to its offline rule-based parser, which is the design.
ANTHROPIC_API_KEY=

# Model used for transaction categorisation.
ANTHROPIC_MODEL=claude-opus-5
